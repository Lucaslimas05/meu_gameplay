page 9 (
    name: Registrar novo jogo
    alias: REGISTRAR-NOVO-JOGO
    title: Registrar novo jogo
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region botões (
        name: Botões
        type: staticContent
        layout {
            sequence: 10
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region registrar-novo-jogo (
        name: Registrar novo jogo
        type: form
        source {
            location: localDatabase
            tableName: JOGO_USUARIO
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P9_HORAS_JOGADAS (
        type: numberField
        label {
            label: Horas Jogadas
            alignment: left
        }
        layout {
            sequence: 60
            region: @registrar-novo-jogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @registrar-novo-jogo
            column: HORAS_JOGADAS
            dataType: number
        }
    )

    pageItem P9_ID (
        type: hidden
        layout {
            sequence: 10
            region: @registrar-novo-jogo
            slot: regionBody
        }
        source {
            formRegion: @registrar-novo-jogo
            column: ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_JOGO_ID (
        type: selectList
        label {
            label: Jogo
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @jogo-nome
        }
        layout {
            sequence: 20
            region: @registrar-novo-jogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @registrar-novo-jogo
            column: JOGO_ID
            dataType: number
        }
    )

    pageItem P9_USUARIO_ID (
        type: hidden
        layout {
            sequence: 50
            region: @registrar-novo-jogo
            slot: regionBody
        }
        source {
            formRegion: @registrar-novo-jogo
            column: USUARIO_ID
            dataType: number
        }
        default {
            type: item
            item: G_USER_ID
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P9_ZERADO (
        type: switch
        label {
            label: Zerado
            alignment: left
        }
        layout {
            sequence: 70
            region: @registrar-novo-jogo
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @registrar-novo-jogo
            column: ZERADO
            dataType: boolean
        }
        sessionState {
            dataType: boolean
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancelar
        layout {
            sequence: 10
            region: @botões
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: SALVAR
        layout {
            sequence: 40
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P9_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Excluir
        layout {
            sequence: 20
            region: @botões
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ID
        }
    )

    button novo (
        buttonName: Novo
        label: Novo jogo
        layout {
            sequence: 30
            region: @registrar-novo-jogo
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
        }
    )

    button save (
        buttonName: SAVE
        label: Aplicar Alterações
        layout {
            sequence: 30
            region: @botões
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P9_ID
        }
    )

    dynamicAction atualizar-jogos (
        name: Atualizar jogos
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: button
            button: @novo
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                    var novoId = this.data.P5_ID;              
                    var item   = apex.item("P9_JOGO_ID");
                    
                    
                    $("#P9_JOGO_ID").one("apexafterrefresh", function () {
                      if (novoId) {
                        item.setValue(novoId);
                      }
                    });
                    
                    item.refresh();   
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process definir-usuário-logado (
        name: Definir usuário logado
        type: executeCode
        source {
            plsqlCode: :P9_USUARIO_ID := :G_USER_ID;
        }
        execution {
            sequence: 5
        }
        advanced {
            executionMappingIdentifier: 16232098179486271926
        }
    )

    process fechar-caixa-de-diálogo (
        name: Fechar Caixa de Diálogo
        type: closeDialog
        execution {
            sequence: 50
        }
        advanced {
            executionMappingIdentifier: 16392433035459799722
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process inicializar-o-form-registrar-novo-jogo (
        name: Inicializar o form Registrar novo jogo
        type: formInitialization
        formRegion: @registrar-novo-jogo
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 16392432215908799719
        }
    )

    process msg-criar (
        name: MSG CRIAR
        type: executeCode
        source {
            plsqlCode: null;
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Jogo adicionado à sua lista!
        }
        advanced {
            executionMappingIdentifier: 16232099136665271936
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

    process msg-editar (
        name: MSG EDITAR
        type: executeCode
        source {
            plsqlCode: null;
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Jogo atualizado com sucesso!
        }
        advanced {
            executionMappingIdentifier: 16232099298310271937
        }
        serverSideCondition {
            whenButtonPressed: @save
        }
    )

    process msg-excluir (
        name: MSG EXCLUIR
        type: executeCode
        source {
            plsqlCode: null;
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Jogo removido da sua lista.
        }
        advanced {
            executionMappingIdentifier: 16232099371963271938
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

    process processar-o-form-registrar-novo-jogo (
        name: Processar o form Registrar novo jogo
        type: formAutoRowProcessing
        formRegion: @registrar-novo-jogo
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 16392432600412799721
        }
    )

)

