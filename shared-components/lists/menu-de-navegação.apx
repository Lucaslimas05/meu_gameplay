list menu-de-navegação (
    name: Menu de Navegação

    entry categorias (
        label: Categorias
        icon {
            imageIconCssClasses: fa-shapes
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: [
                2
                3
            ]
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry início (
        label: Início
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry jogos (
        label: Jogos
        icon {
            imageIconCssClasses: fa-gamepad
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: [
                4
                5
            ]
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry meus-jogos (
        label: Meus Jogos
        icon {
            imageIconCssClasses: fa-trophy
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                8
                9
            ]
        }
        link {
            target: {
                page: 8
            }
        }
    )

)

